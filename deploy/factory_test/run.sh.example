#!/bin/sh
# Boot hook for PolypLink (example, without personal data).
#
# The firmware runs it as root at boot, while the USB stick is mounted.
# It only serves to keep SSH enabled. To use it:
#
#   cp run.sh.example run.sh
#   # add your public key in the block below
#
# run.sh is ignored by git: it will contain your key (and, if you want, the password).

mkdir -p /home/steam/.ssh /root/.ssh 2>/dev/null

# --- your public key, a single line --------------------------------------
# cat > /root/.ssh/authorized_keys <<'KEY'
# ssh-ed25519 AAAA... you@example
# KEY
# cp -f /root/.ssh/authorized_keys /home/steam/.ssh/authorized_keys 2>/dev/null

chmod 700 /home/steam/.ssh /root/.ssh 2>/dev/null
chmod 600 /home/steam/.ssh/authorized_keys /root/.ssh/authorized_keys 2>/dev/null
chmod go-w /home/steam /root 2>/dev/null

# Keeps SSH enabled even after a factory reset
touch /mnt/config/system/enable_ssh.txt 2>/dev/null

exit 0
